# ==========================================
# SOVA Environment Configuration
# ==========================================

# Application
APP_NAME=SOVA
APP_ENV=development
DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
FRONTEND_PORT=5173

# API
VITE_API_URL=http://localhost:8000

# Storage
DATA_DIR=/workspace/data
OUTPUT_DIR=/workspace/outputs
RULES_PATH=/workspace/rules/kz_compliance_rules.json

# ML
ML_PROVIDER=qwen

# Model settings
QWEN_MODEL_ID=
DINO_MODEL_ID=

# Processing
MAX_VIDEO_SIZE_MB=500
FRAME_SAMPLE_INTERVAL=2

# GPU
USE_GPU=false